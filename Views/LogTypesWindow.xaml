<Window x:Class="LogAggregator.Views.LogTypesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:conv="clr-namespace:LogAggregator.Converters"
        xmlns:vm="clr-namespace:LogAggregator.ViewModels"
        Style="{StaticResource Style.BaseWindow}"
        Title="Manage Log Types"
        Width="560" Height="620" MinWidth="440" MinHeight="360"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        WindowStyle="None" AllowsTransparency="False"
        Background="{StaticResource Brush.Background}"
        ShowInTaskbar="False">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                             CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush"/>
        <conv:IconKeyToGeometryConverter x:Key="IconKeyToGeometry"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Height="34" Background="{StaticResource Brush.SurfaceRaised}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Manage Log Types" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource Brush.TextSecondary}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource Style.CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize"/>
                    <Button Style="{StaticResource Style.CaptionButton}" Content="&#xE922;" Click="MaximizeRestore_Click" ToolTip="Maximize"/>
                    <Button Style="{StaticResource Style.CaptionCloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Foreground="{StaticResource Brush.TextSecondary}" TextWrapping="Wrap" VerticalAlignment="Center"
                           Text="Define reusable log formats here, then drag files onto a LogType's icon on any Source card to load them."/>
                <Button Grid.Column="1" Content="+ New Log Type" Style="{StaticResource Style.PrimaryButton}"
                        Command="{Binding AddCommand}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Top"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding LogTypes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Style.Card}" Margin="0,0,0,8" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Margin="0,0,10,0"
                                            Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}">
                                        <Path Width="15" Height="15" Stretch="Uniform" Fill="#FF0B0E12"
                                              Data="{Binding IconGlyph, Converter={StaticResource IconKeyToGeometry}}"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Style.CardTitle}"/>
                                        <TextBlock Text="{Binding Format}" Style="{StaticResource Style.CardSubtext}"/>
                                    </StackPanel>

                                    <Button Grid.Column="2" Content="Edit" Style="{StaticResource Style.SecondaryButton}" FontSize="11.5"
                                            Padding="10,4" Margin="0,0,8,0"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Grid.Column="3" Content="Delete" Style="{StaticResource Style.SecondaryButton}" FontSize="11.5"
                                            Padding="10,4" Foreground="{StaticResource Brush.Error}"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
