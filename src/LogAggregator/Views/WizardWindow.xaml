<Window x:Class="LogAggregator.Views.WizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:conv="clr-namespace:LogAggregator.Converters"
        xmlns:models="clr-namespace:LogAggregator.Models"
        Style="{StaticResource Style.BaseWindow}"
        Title="Data Source"
        Width="640" Height="700" MinWidth="580" MinHeight="580"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        WindowStyle="None" AllowsTransparency="False"
        Background="{StaticResource Brush.Background}"
        ShowInTaskbar="False">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                             CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>
        <conv:IntEqualsToVisibilityConverter x:Key="StepVis"/>
        <conv:EnumToBoolConverter x:Key="EnumToBool"/>
        <conv:HexToBrushConverter x:Key="HexToBrush"/>

        <Style x:Key="Style.CandidateListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="Style.CandidateItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" Background="{StaticResource Brush.SurfaceBase}" BorderThickness="1.4"
                                BorderBrush="{StaticResource Brush.Border}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Brush.AccentGreen}"/>
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.SurfaceHover}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Brush.AccentBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Border Grid.Row="0" Height="34" Background="{StaticResource Brush.SurfaceRaised}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource Brush.TextSecondary}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="New Data Source"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                    <Setter Property="Text" Value="Edit Data Source"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource Style.CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize"/>
                    <Button Style="{StaticResource Style.CaptionButton}" Content="&#xE922;" Click="MaximizeRestore_Click" ToolTip="Maximize"/>
                    <Button Style="{StaticResource Style.CaptionCloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Step indicator -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
                <StackPanel.Resources>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="40"/>
                        <Setter Property="Height" Value="4"/>
                        <Setter Property="CornerRadius" Value="2"/>
                        <Setter Property="Margin" Value="0,0,6,0"/>
                        <Setter Property="Background" Value="{StaticResource Brush.Border}"/>
                    </Style>
                </StackPanel.Resources>
                <Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                    <Style.Triggers><DataTrigger Binding="{Binding StepIndex}" Value="0"><Setter Property="Background" Value="{StaticResource Brush.AccentGreen}"/></DataTrigger></Style.Triggers></Style></Border.Style></Border>
                <Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                    <Style.Triggers><DataTrigger Binding="{Binding StepIndex}" Value="1"><Setter Property="Background" Value="{StaticResource Brush.AccentGreen}"/></DataTrigger></Style.Triggers></Style></Border.Style></Border>
                <Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                    <Style.Triggers><DataTrigger Binding="{Binding StepIndex}" Value="2"><Setter Property="Background" Value="{StaticResource Brush.AccentGreen}"/></DataTrigger></Style.Triggers></Style></Border.Style></Border>
                <Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                    <Style.Triggers><DataTrigger Binding="{Binding StepIndex}" Value="3"><Setter Property="Background" Value="{StaticResource Brush.AccentGreen}"/></DataTrigger></Style.Triggers></Style></Border.Style></Border>
            </StackPanel>

            <!-- Step content -->
            <Grid Grid.Row="1">

                <!-- Step 0: Files -->
                <Grid Visibility="{Binding StepIndex, Converter={StaticResource StepVis}, ConverterParameter=0}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Add the file(s) for this source. File type and timestamp pattern are detected automatically."
                               Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,14" TextWrapping="Wrap"/>

                    <Border Grid.Row="1" x:Name="FileDropZone" Style="{StaticResource Style.DropZoneBorder}" Height="140" Margin="0,0,0,14"
                            AllowDrop="True" Drop="FileDropZone_Drop" DragEnter="FileDropZone_DragEnter" DragLeave="FileDropZone_DragLeave">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="40" Height="40" CornerRadius="8" BorderThickness="2" BorderBrush="{StaticResource Brush.AccentGreen}"
                                    HorizontalAlignment="Center">
                                <Path Width="18" Height="18" Stretch="Uniform" Fill="{StaticResource Brush.AccentGreen}"
                                      Data="M9,0 L11,0 L11,9 L20,9 L20,11 L11,11 L11,20 L9,20 L9,11 L0,11 L0,9 L9,9 Z"/>
                            </Border>
                            <TextBlock Text="Drag files or a .zip here" Foreground="{StaticResource Brush.TextSecondary}" FontSize="12.5"
                                       Margin="0,10,0,4" HorizontalAlignment="Center"/>
                            <Button Content="or Browse..." Style="{StaticResource Style.SecondaryButton}" FontSize="11.5" Padding="10,4"
                                    Command="{Binding BrowseFilesCommand}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="6" MaxHeight="180">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding PendingFilePaths}" Margin="4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding}" Foreground="{StaticResource Brush.TextSecondary}"
                                                       FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Content="&#x2715;" Style="{StaticResource Style.IconButton}" Width="24" Height="24"
                                                    Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- Step 1: Detection -->
                <ScrollViewer Visibility="{Binding StepIndex, Converter={StaticResource StepVis}, ConverterParameter=1}"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <Border Padding="12" CornerRadius="6" Margin="0,0,0,14">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#1A3DDC97"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                            <Setter Property="Background" Value="#1AE05C5C"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsAmbiguous}" Value="True">
                                            <Setter Property="Background" Value="#1AE0A63D"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}" Margin="0,0,0,4">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Detected automatically"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAmbiguous}" Value="True">
                                                    <Setter Property="Text" Value="Multiple possible timestamps found"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                    <Setter Property="Text" Value="Couldn't auto-detect a timestamp"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding DetectedFileTypeLabel, StringFormat='File type: {0}'}"
                                           Foreground="{StaticResource Brush.TextSecondary}" FontSize="12" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding DetectionMessage}" Foreground="{StaticResource Brush.TextSecondary}"
                                           FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Ambiguous: pick which candidate is correct -->
                        <ListBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate}"
                                 Style="{StaticResource Style.CandidateListBox}" ItemContainerStyle="{StaticResource Style.CandidateItem}"
                                 Visibility="{Binding IsAmbiguous, Converter={StaticResource BoolToVis}}" Margin="0,0,0,14">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource Brush.TextPrimary}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Foreground="{StaticResource Brush.TextMuted}" FontSize="11" Margin="0,4,0,0">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="Example: {0}  ->  {1:yyyy-MM-dd HH:mm:ss}  ({2:P0} of sample lines)">
                                                    <Binding Path="ExampleRawText"/>
                                                    <Binding Path="ExampleUtc"/>
                                                    <Binding Path="MatchRate"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Confident: optional manual override -->
                        <Expander Header="Override manually" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,0"
                                  IsExpanded="{Binding ShowManualOverride}"
                                  Visibility="{Binding IsFailed, Converter={StaticResource InverseBoolToVis}}">
                            <StackPanel Margin="0,10,0,0">
                                <StackPanel Visibility="{Binding IsDelimitedType, Converter={StaticResource InverseBoolToVis}}">
                                    <TextBlock Text="Leading regex (must contain a group - either named &quot;ts&quot; or the first group)"
                                               Foreground="{StaticResource Brush.TextMuted}" FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                    <TextBox Style="{StaticResource Style.DarkTextBox}" FontFamily="Consolas" FontSize="11.5"
                                             Text="{Binding ManualRegexPattern, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Visibility="{Binding IsDelimitedType, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                                    <CheckBox Content="Date and time are in two separate columns" Style="{StaticResource Style.DarkCheckBox}"
                                              IsChecked="{Binding UseTwoColumnMode}" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding PrimaryColumnLabel}" Foreground="{StaticResource Brush.TextMuted}" FontSize="11" Margin="0,0,0,4"/>
                                            <TextBox Style="{StaticResource Style.DarkTextBox}" Text="{Binding ManualColumnIndex, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0" Visibility="{Binding UseTwoColumnMode, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding SecondColumnLabel}" Foreground="{StaticResource Brush.TextMuted}" FontSize="11" Margin="0,0,0,4"/>
                                            <TextBox Style="{StaticResource Style.DarkTextBox}" Text="{Binding ManualSecondColumnIndex, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <TextBlock Text=".NET format string (optional - leave blank to auto-match common formats)"
                                           Foreground="{StaticResource Brush.TextMuted}" FontSize="11" Margin="0,10,0,4" TextWrapping="Wrap"/>
                                <TextBox Style="{StaticResource Style.DarkTextBox}" FontFamily="Consolas" FontSize="11.5"
                                         Text="{Binding ManualFormatString, UpdateSourceTrigger=PropertyChanged}"/>

                                <Button Content="Test Manual Pattern" Style="{StaticResource Style.SecondaryButton}"
                                        Command="{Binding ApplyManualCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>

                                <Border Margin="0,10,0,0" Padding="8" CornerRadius="5" Visibility="{Binding ManualTestMessage, Converter={StaticResource BoolToVis}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#1A3DDC97"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ManualTestIsSuccess}" Value="False">
                                                    <Setter Property="Background" Value="#1AE05C5C"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding ManualTestMessage}" TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource Brush.TextPrimary}"/>
                                </Border>
                            </StackPanel>
                        </Expander>

                        <!-- Failed: manual entry is the only path forward -->
                        <StackPanel Visibility="{Binding IsFailed, Converter={StaticResource BoolToVis}}">
                            <StackPanel Visibility="{Binding IsDelimitedType, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="Leading regex (must contain a group - either named &quot;ts&quot; or the first group)"
                                           Foreground="{StaticResource Brush.TextMuted}" FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                <TextBox Style="{StaticResource Style.DarkTextBox}" FontFamily="Consolas" FontSize="11.5"
                                         Text="{Binding ManualRegexPattern, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsDelimitedType, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                                <CheckBox Content="Date and time are in two separate columns" Style="{StaticResource Style.DarkCheckBox}"
                                          IsChecked="{Binding UseTwoColumnMode}" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding PrimaryColumnLabel}" Foreground="{StaticResource Brush.TextMuted}" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource Style.DarkTextBox}" Text="{Binding ManualColumnIndex, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0" Visibility="{Binding UseTwoColumnMode, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding SecondColumnLabel}" Foreground="{StaticResource Brush.TextMuted}" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource Style.DarkTextBox}" Text="{Binding ManualSecondColumnIndex, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <TextBlock Text=".NET format string (optional - leave blank to auto-match common formats)"
                                       Foreground="{StaticResource Brush.TextMuted}" FontSize="11" Margin="0,10,0,4" TextWrapping="Wrap"/>
                            <TextBox Style="{StaticResource Style.DarkTextBox}" FontFamily="Consolas" FontSize="11.5"
                                     Text="{Binding ManualFormatString, UpdateSourceTrigger=PropertyChanged}"/>

                            <Button Content="Test Manual Pattern" Style="{StaticResource Style.SecondaryButton}"
                                    Command="{Binding ApplyManualCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>

                            <Border Margin="0,10,0,0" Padding="8" CornerRadius="5" Visibility="{Binding ManualTestMessage, Converter={StaticResource BoolToVis}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#1A3DDC97"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ManualTestIsSuccess}" Value="False">
                                                <Setter Property="Background" Value="#1AE05C5C"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding ManualTestMessage}" TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource Brush.TextPrimary}"/>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <!-- Step 2: Name -->
                <StackPanel Visibility="{Binding StepIndex, Converter={StaticResource StepVis}, ConverterParameter=2}">
                    <TextBlock Text="Give this source a friendly name." Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                    <TextBox Style="{StaticResource Style.DarkTextBox}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="15" Padding="10,8"/>
                    <TextBlock Text="Suggested from the file name - feel free to change it." Foreground="{StaticResource Brush.TextMuted}" FontSize="11" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Step 3: Color -->
                <StackPanel Visibility="{Binding StepIndex, Converter={StaticResource StepVis}, ConverterParameter=3}">
                    <TextBlock Text="Pick a display color for this source's rows." Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,14" TextWrapping="Wrap"/>
                    <Border Width="52" Height="52" CornerRadius="26" HorizontalAlignment="Left" Margin="0,0,0,16"
                            BorderThickness="2" BorderBrush="{StaticResource Brush.Border}"
                            Background="{Binding SelectedColorHex, Converter={StaticResource HexToBrush}}"/>
                    <ItemsControl ItemsSource="{Binding Presets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="34" Height="34" Margin="0,0,10,10" Cursor="Hand"
                                        Command="{Binding DataContext.PickPresetColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="17" Background="{Binding Converter={StaticResource HexToBrush}}"
                                                    BorderThickness="2" BorderBrush="{StaticResource Brush.Border}"/>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Or enter a hex color:" Foreground="{StaticResource Brush.TextMuted}" FontSize="11" Margin="0,10,0,4"/>
                    <TextBox Style="{StaticResource Style.DarkTextBox}" Width="140" HorizontalAlignment="Left"
                             Text="{Binding SelectedColorHex, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

            </Grid>

            <!-- Footer: toast + nav buttons -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource Brush.SurfaceHover}" CornerRadius="5" Padding="10,7" Margin="0,0,0,10"
                        Visibility="{Binding ToastVisible, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ToastMessage}" Foreground="{StaticResource Brush.TextPrimary}" FontSize="12" TextWrapping="Wrap"/>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Delete Source" Style="{StaticResource Style.SecondaryButton}"
                            Foreground="{StaticResource Brush.Error}" Click="DeleteButton_Click"
                            Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="Cancel" Style="{StaticResource Style.SecondaryButton}" Command="{Binding CancelCommand}" Margin="0,0,8,0"/>
                        <Button Content="Back" Style="{StaticResource Style.SecondaryButton}" Command="{Binding BackCommand}" Margin="0,0,8,0"
                                Visibility="{Binding IsFirstStep, Converter={StaticResource InverseBoolToVis}}"/>
                        <Button Content="Next" Style="{StaticResource Style.PrimaryButton}" Command="{Binding NextCommand}"
                                Visibility="{Binding IsLastStep, Converter={StaticResource InverseBoolToVis}}"/>
                        <Button Content="Finish" Style="{StaticResource Style.PrimaryButton}" Command="{Binding FinishCommand}"
                                Visibility="{Binding IsLastStep, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
