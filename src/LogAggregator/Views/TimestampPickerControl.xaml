<UserControl x:Class="LogAggregator.Views.TimestampPickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:LogAggregator.Converters"
             xmlns:vm="clr-namespace:LogAggregator.ViewModels"
             d:DataContext="{d:DesignInstance vm:TimestampPickerViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:TimestampTokenHintToBrushConverter x:Key="HintToBrush"/>
        <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVis"/>

        <!-- Dark-themed ToggleButton for token chunks - default WPF chrome would render a
             light beveled button that clashes badly against this app's dark surfaces. -->
        <Style x:Key="Style.TokenToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1.4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Brush.AccentGreen}"/>
                                <Setter TargetName="Bg" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Brush.AccentBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Foreground="{StaticResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,10">
            <Run Text="Every highlighted chunk below is a button - click one to include it, then pick what it is."/>
            <Run Text=" Chunks tinted green look like they could be the date, blue like they could be the time - but you decide."/>
        </TextBlock>

        <Border Background="{StaticResource Brush.SurfaceBase}" BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,6">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Sample line" Style="{StaticResource Style.SectionHeader}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Try another sample line" Style="{StaticResource Style.SecondaryButton}"
                            FontSize="11" Padding="8,3" Command="{Binding SelectAnotherLineCommand}"/>
                </Grid>

                <!-- The one-click suggestion: only shown when TimestampDetector recognized a
                     whole leading-timestamp shape on this line (SuggestedToken/HasSuggestion -
                     see TimestampPickerViewModel). Selecting it is equivalent to tagging the
                     entire highlighted span as one Date+Time chunk in one click, instead of
                     clicking and tagging every digit run below by hand. -->
                <Border Visibility="{Binding HasSuggestion, Converter={StaticResource BoolToVis}}"
                        Background="{StaticResource Brush.AccentGreenGlow}" BorderBrush="{StaticResource Brush.AccentGreen}"
                        BorderThickness="1.4" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{StaticResource Brush.AccentGreen}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Looks like a timestamp - want to use the whole thing?"
                                       Foreground="{StaticResource Brush.TextPrimary}" FontSize="12" FontWeight="SemiBold"/>
                            <ToggleButton IsChecked="{Binding SuggestedToken.IsSelected}" Cursor="Hand"
                                          HorizontalAlignment="Left" Margin="0,4,0,0" Padding="8,4" FontFamily="Consolas" FontSize="12">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton" BasedOn="{StaticResource Style.TokenToggle}">
                                        <Setter Property="Background" Value="{StaticResource Brush.SurfaceRaised}"/>
                                    </Style>
                                </ToggleButton.Style>
                                <TextBlock Text="{Binding SuggestedToken.Text}"/>
                            </ToggleButton>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Tokens}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,6,8" VerticalAlignment="Top">
                                <ToggleButton Style="{StaticResource Style.TokenToggle}" IsChecked="{Binding IsSelected}"
                                              Padding="6,3" FontFamily="Consolas" FontSize="12"
                                              Background="{Binding Hint, Converter={StaticResource HintToBrush}}">
                                    <TextBlock Text="{Binding Text}"/>
                                </ToggleButton>
                                <ComboBox Margin="0,3,0,0" FontSize="11" Width="92"
                                          Style="{StaticResource Style.DarkComboBox}"
                                          Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"
                                          ItemsSource="{x:Static vm:TimestampTokenViewModel.AvailableRoles}"
                                          SelectedItem="{Binding Role}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding OtherSampleLines}" Margin="0,0,0,10">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="10.5"
                               Foreground="{StaticResource Brush.TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,1"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text=".NET format string (optional - leave blank to auto-match common formats)"
                   Foreground="{StaticResource Brush.TextMuted}" FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap"/>
        <TextBox Style="{StaticResource Style.DarkTextBox}" FontFamily="Consolas" FontSize="11.5"
                 Text="{Binding ManualFormatString, UpdateSourceTrigger=PropertyChanged}"/>

        <Button Content="Apply Selection" Style="{StaticResource Style.PrimaryButton}"
                Command="{Binding ApplyCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>

        <Border Margin="0,10,0,0" Padding="8" CornerRadius="5" Visibility="{Binding TestMessage, Converter={StaticResource StringNotEmptyToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#1A3DDC97"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding TestIsSuccess}" Value="False">
                            <Setter Property="Background" Value="#1AE05C5C"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding TestMessage}" TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource Brush.TextPrimary}"/>
        </Border>
    </StackPanel>
</UserControl>
