<Window x:Class="LogAggregator.Views.WarningsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:conv="clr-namespace:LogAggregator.Converters"
        xmlns:vm="clr-namespace:LogAggregator.ViewModels"
        d:DataContext="{d:DesignInstance vm:WarningsViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Style="{StaticResource Style.BaseWindow}"
        Title="{Binding Title}"
        Width="700" Height="620" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        WindowStyle="None" AllowsTransparency="False"
        Background="{StaticResource Brush.Background}"
        ShowInTaskbar="False">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                             CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:CountToVisibilityConverter x:Key="CountToVis"/>
        <conv:CountToVisibilityConverter x:Key="CountToVisInverted" Invert="True"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Height="34" Background="{StaticResource Brush.SurfaceRaised}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Title}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource Brush.TextSecondary}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource Style.CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize"/>
                    <Button Style="{StaticResource Style.CaptionButton}" Content="&#xE922;" Click="MaximizeRestore_Click" ToolTip="Maximize"/>
                    <Button Style="{StaticResource Style.CaptionCloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Foreground="{StaticResource Brush.TextSecondary}" TextWrapping="Wrap" VerticalAlignment="Center">
                    <Run Text="Every row here is a line or file that didn't parse the way its LogType expected - the row was still kept"/>
                    <Run Text=" (with a sentinel timestamp) rather than silently dropped, so nothing goes missing even in the worst case."/>
                </TextBlock>
                <Button Grid.Column="1" Content="Refresh" Style="{StaticResource Style.SecondaryButton}"
                        Command="{Binding RefreshCommand}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Top"/>
            </Grid>

            <TextBlock Grid.Row="1" Text="No parse warnings - everything matched its LogType's timestamp pattern."
                       Foreground="{StaticResource Brush.TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Top"
                       Margin="0,24,0,0" FontSize="12"
                       Visibility="{Binding Rows.Count, Converter={StaticResource CountToVisInverted}}"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding Rows.Count, Converter={StaticResource CountToVis}}">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Style.Card}" Margin="0,0,0,8" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="10" Height="10" CornerRadius="5" Margin="0,4,10,0"
                                            VerticalAlignment="Top"
                                            Background="{Binding LogTypeColorHex, Converter={StaticResource HexToBrush}}"/>

                                    <StackPanel Grid.Column="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource Style.CardTitle}">
                                                <Run Text="{Binding SourceName, Mode=OneWay}"/>
                                                <Run Text=" / "/>
                                                <Run Text="{Binding LogTypeName, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Grid.Column="1" Text="{Binding OccurredAtText}" FontSize="11"
                                                       Foreground="{StaticResource Brush.TextSecondary}"/>
                                        </Grid>

                                        <TextBlock Text="{Binding LocationText}" Style="{StaticResource Style.CardSubtext}"
                                                   Margin="0,2,0,0" TextWrapping="Wrap"/>

                                        <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12.5"
                                                   Foreground="{StaticResource Brush.Warning}"/>

                                        <Border Margin="0,6,0,0" Padding="8,5" CornerRadius="4"
                                                Background="{StaticResource Brush.SurfaceBase}"
                                                Visibility="{Binding HasRawText, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding RawText}" FontFamily="Consolas" FontSize="11.5"
                                                       TextWrapping="Wrap" Foreground="{StaticResource Brush.TextSecondary}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
