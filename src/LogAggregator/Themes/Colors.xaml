<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Core surfaces -->
    <Color x:Key="Color.Background">#FF0F1115</Color>
    <Color x:Key="Color.SurfaceBase">#FF161920</Color>
    <Color x:Key="Color.SurfaceRaised">#FF1E222B</Color>
    <Color x:Key="Color.SurfaceHover">#FF262B36</Color>
    <Color x:Key="Color.Border">#FF2A2F3A</Color>
    <Color x:Key="Color.BorderSubtle">#FF20242D</Color>

    <!-- Text -->
    <Color x:Key="Color.TextPrimary">#FFE8EBF0</Color>
    <Color x:Key="Color.TextSecondary">#FF9AA3B2</Color>
    <Color x:Key="Color.TextMuted">#FF666E7D</Color>
    <Color x:Key="Color.TextDisabled">#FF454B58</Color>

    <!-- Accents: green + blue -->
    <Color x:Key="Color.AccentGreen">#FF3DDC97</Color>
    <Color x:Key="Color.AccentGreenDim">#FF2A9D6F</Color>
    <Color x:Key="Color.AccentGreenGlow">#553DDC97</Color>
    <Color x:Key="Color.AccentBlue">#FF4C9BFF</Color>
    <Color x:Key="Color.AccentBlueDim">#FF3577D4</Color>
    <Color x:Key="Color.AccentBlueGlow">#554C9BFF</Color>

    <!-- Status -->
    <Color x:Key="Color.Warning">#FFE0A63D</Color>
    <Color x:Key="Color.Error">#FFE05C5C</Color>
    <Color x:Key="Color.Idle">#FFCED3DB</Color>

    <!-- Scrollbar -->
    <Color x:Key="Color.ScrollTrack">#FF14171D</Color>
    <Color x:Key="Color.ScrollThumb">#FF373D4A</Color>
    <Color x:Key="Color.ScrollThumbHover">#FF4C9BFF</Color>

</ResourceDictionary>
