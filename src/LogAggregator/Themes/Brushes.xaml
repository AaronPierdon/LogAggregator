<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}"/>
    <SolidColorBrush x:Key="Brush.SurfaceBase" Color="{StaticResource Color.SurfaceBase}"/>
    <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="{StaticResource Color.SurfaceRaised}"/>
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.SurfaceHover}"/>
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}"/>
    <SolidColorBrush x:Key="Brush.BorderSubtle" Color="{StaticResource Color.BorderSubtle}"/>

    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}"/>
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="{StaticResource Color.TextDisabled}"/>

    <SolidColorBrush x:Key="Brush.AccentGreen" Color="{StaticResource Color.AccentGreen}"/>
    <SolidColorBrush x:Key="Brush.AccentGreenDim" Color="{StaticResource Color.AccentGreenDim}"/>
    <SolidColorBrush x:Key="Brush.AccentGreenGlow" Color="{StaticResource Color.AccentGreenGlow}"/>
    <SolidColorBrush x:Key="Brush.AccentBlue" Color="{StaticResource Color.AccentBlue}"/>
    <SolidColorBrush x:Key="Brush.AccentBlueDim" Color="{StaticResource Color.AccentBlueDim}"/>
    <SolidColorBrush x:Key="Brush.AccentBlueGlow" Color="{StaticResource Color.AccentBlueGlow}"/>

    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}"/>
    <SolidColorBrush x:Key="Brush.Error" Color="{StaticResource Color.Error}"/>
    <SolidColorBrush x:Key="Brush.Idle" Color="{StaticResource Color.Idle}"/>

    <SolidColorBrush x:Key="Brush.ScrollTrack" Color="{StaticResource Color.ScrollTrack}"/>
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="{StaticResource Color.ScrollThumb}"/>
    <SolidColorBrush x:Key="Brush.ScrollThumbHover" Color="{StaticResource Color.ScrollThumbHover}"/>

    <LinearGradientBrush x:Key="Brush.AccentGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource Color.AccentGreen}" Offset="0"/>
        <GradientStop Color="{StaticResource Color.AccentBlue}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Base window/app styles -->
    <Style TargetType="Window" x:Key="Style.BaseWindow">
        <Setter Property="Background" Value="{StaticResource Brush.Background}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

</ResourceDictionary>
