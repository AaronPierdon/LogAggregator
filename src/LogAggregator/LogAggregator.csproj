<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>LogAggregator</RootNamespace>
    <AssemblyName>LogAggregator</AssemblyName>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>

    <!-- Self-contained single-file publish settings.
         Build with: dotnet publish -c Release -r win-x64 -p:SelfContained=true
         (see PUBLISH.md for the full command and options) -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <SelfContainedPublishOverridesGlobalWebProxy>true</SelfContainedPublishOverridesGlobalWebProxy>

    <!-- Keep this off during normal Debug/Release F5 builds - it only matters for `dotnet publish` -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>

    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <None Update="app.manifest" CopyToOutputDirectory="PreserveNewest" Condition="Exists('app.manifest')" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dapper: micro-ORM, executes plain SQL against any IDbConnection.
         Microsoft.Data.Sqlite: embedded, file-based SQL engine - no local server/service to
         install or run. Bundles a native SQLite binary per-RID, which publishes cleanly as
         part of a self-contained single-file build (this is one of the most common/best-tested
         native dependencies in the .NET publish pipeline). -->
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />

    <!-- NodaTime: the de facto standard .NET date/time library (Apache-2.0 license, actively
         maintained, ~450K+ downloads on the packages that build on it) - used by
         TimestampDetector for exact-format timestamp parsing instead of a hand-rolled
         DateTime.TryParseExact loop. It's explicit about anything a format string doesn't
         specify (a missing year, a 2-digit year's century) via an explicit TemplateValue,
         rather than DateTime.TryParseExact's ambient OS-locale-dependent defaults - see
         Services/TimestampDetector.cs (TryParseWithNodaTime) for details. The original
         DateTime.TryParseExact call is kept as an automatic fallback for every format string,
         so this can only add parsing coverage, never remove it. Apache-2.0 is fully
         commercial-friendly: free to use forever, no restriction on charging for the app. -->
    <PackageReference Include="NodaTime" Version="3.2.2" />
  </ItemGroup>

  <!-- ===================================================================================
       SIMULATION MODE (opt-in, OFF by default) - lets the app be launched as
       "LogAggregator.exe" with a simulate flag to stress-test Services/TimestampDetector.cs against
       randomly generated log files instead of showing the UI. See App.xaml.cs
       (TryHandleSimulationArgs) for the runtime side and tests/LogAggregator.SampleData for
       the generator/report engine it calls into.

       Left OFF (IncludeSimulationMode unset -> "false" below), a normal `dotnet build` / F5 in
       Visual Studio:
         - does NOT define the SIMULATION_MODE compiler symbol (so App.xaml.cs's whole
           #if SIMULATION_MODE block, including the simulate-flag argument handling, is not
           compiled into the app at all - not just hidden behind a runtime check), and
         - does NOT add a ProjectReference to LogAggregator.SampleData, so that project isn't
           even built as part of the app.
       In other words this is byte-for-byte identical to the app before this feature existed,
       unless someone deliberately opts in.

       To opt in for one build: `dotnet build -p:IncludeSimulationMode=true` (or set
       <IncludeSimulationMode>true</IncludeSimulationMode> in a Directory.Build.props / your
       own local build profile - never commit that as the checked-in default).

       This is the answer to "should this be removable, or a permanent advanced setting?": it's
       built to just stay here, permanently, but be permanently inert unless explicitly turned
       on - so there's nothing to remember to rip back out later, and no risk of ever shipping
       it on by accident.
       =================================================================================== -->
  <PropertyGroup>
    <IncludeSimulationMode Condition="'$(IncludeSimulationMode)' == ''">false</IncludeSimulationMode>
  </PropertyGroup>

  <ItemGroup Condition="'$(IncludeSimulationMode)' == 'true'">
    <ProjectReference Include="..\..\tests\LogAggregator.SampleData\LogAggregator.SampleData.csproj" />
  </ItemGroup>

  <PropertyGroup Condition="'$(IncludeSimulationMode)' == 'true'">
    <DefineConstants>$(DefineConstants);SIMULATION_MODE</DefineConstants>
  </PropertyGroup>

</Project>
